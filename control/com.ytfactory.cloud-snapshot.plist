<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ytfactory.cloud-snapshot</string>

    <!-- Daily admin-panel snapshot: writes data/_bench/cloud_{health, -->
    <!-- cost,deploys}/YYYY-MM-DD.json. Powers the /app/cloud tab. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/rohit/ytFactory &amp;&amp; /Users/rohit/ytFactory/.venv/bin/python /Users/rohit/ytFactory/scripts/cloud_daily_snapshot.py --quiet &gt;&gt; /tmp/ytfactory-cloud-snapshot.log 2&gt;&amp;1</string>
    </array>

    <!-- Run once a day at 02:00 local (idle hours). Pick a different -->
    <!-- hour by editing Hour below and reloading the plist. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Catch up on next wake if the laptop was asleep at 02:00. -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/ytfactory-cloud-snapshot.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ytfactory-cloud-snapshot.log</string>

    <!-- Audit D3.18 — pre-fix this plist had no EnvironmentVariables, -->
    <!-- so launchd inherited only its (very minimal) PATH. gcloud / -->
    <!-- gsutil / git failed silently with "command not found"; the -->
    <!-- snapshot script appeared to "run" but produced empty output. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/rohit</string>
        <key>PATH</key>
        <string>/Users/rohit/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/rohit/google-cloud-sdk/bin</string>
        <key>CLOUDSDK_CONFIG</key>
        <string>/Users/rohit/.config/gcloud</string>
        <key>GOOGLE_CLOUD_PROJECT</key>
        <string>ytfactory-prod-v2</string>
    </dict>
</dict>
</plist>
