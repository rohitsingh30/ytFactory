<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ytfactory.upload-next</string>

  <!--
    Run scripts/ops/upload_next.py at 10 slots per day, every 2.4 hrs.
    Slots in LOCAL system time (configure your Mac to IST if you
    want IST slots; launchd has no per-job timezone option).
    Slots: 07:00, 09:24, 11:48, 14:12, 16:36, 19:00, 21:24, 23:48,
           02:12, 04:36
  -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>24</integer></dict>
    <dict><key>Hour</key><integer>11</integer><key>Minute</key><integer>48</integer></dict>
    <dict><key>Hour</key><integer>14</integer><key>Minute</key><integer>12</integer></dict>
    <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>36</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>24</integer></dict>
    <dict><key>Hour</key><integer>23</integer><key>Minute</key><integer>48</integer></dict>
    <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>12</integer></dict>
    <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>36</integer></dict>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/rohit/ytFactory</string>

  <!--
    Source .env explicitly so CLOUDRUN_* + GCP creds are visible to
    the upload subprocess. launchd ignores user shell init.

    Audit D3.19 — pre-fix this used a RELATIVE venv path
    (`.venv/bin/python`); critique-runner / cloud-snapshot use
    absolute venv paths (`/Users/rohit/ytFactory/.venv/bin/python`).
    Normalise to the absolute path so the plist is portable to any
    user's shell context (launchd quirks: WorkingDirectory is set
    BEFORE -c expansion but RELATIVE paths still resolve from the
    spawning launchctl context, not always from WorkingDirectory).
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd /Users/rohit/ytFactory &amp;&amp; set -a &amp;&amp; source .env &amp;&amp; set +a &amp;&amp; PYTHONPATH=. /Users/rohit/ytFactory/.venv/bin/python -u scripts/ops/upload_next.py --count 1</string>
  </array>

  <key>StandardOutPath</key>
  <string>/tmp/upload_next.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/upload_next.log</string>

  <key>RunAtLoad</key>
  <false/>

  <!-- Audit D3.18 — pre-fix this plist had no EnvironmentVariables, -->
  <!-- so launchd inherited only its minimal PATH. The upload_next -->
  <!-- subprocess shells out to ffmpeg + gcloud + git; all three -->
  <!-- failed silently with "command not found" inside launchd. -->
  <!-- Audit D3.19 — also normalising to the absolute-venv + module -->
  <!-- form used by critique-runner.plist for cross-plist consistency. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/rohit</string>
    <key>PATH</key>
    <string>/Users/rohit/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/rohit/google-cloud-sdk/bin</string>
    <key>CLOUDSDK_CONFIG</key>
    <string>/Users/rohit/.config/gcloud</string>
    <key>GOOGLE_CLOUD_PROJECT</key>
    <string>ytfactory-prod-v3</string>
  </dict>
</dict>
</plist>
