<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ytfactory.job-reconciler</string>
    <!-- Cloud Run JOB execution reconciler — B3b in 2026-05-23 docket.   -->
    <!-- Sweeps Firestore for render jobs stuck mid-pipeline whose JOB    -->
    <!-- execution has finished failing (SIGKILL / OOM / task-timeout)    -->
    <!-- and marks them status=failed so the dashboard surfaces them.    -->
    <!-- See control/core/reconciler.py for the full docstring.           -->
    <!-- 2026-05-24: switched from `curl POST http://127.0.0.1:8090/...`  -->
    <!-- to direct Python invocation. The HTTP path was a silent no-op    -->
    <!-- whenever the laptop FastAPI server wasn't running — which is     -->
    <!-- exactly the state we want the reconciler to survive (the laptop  -->
    <!-- server crashing leaves jobs stuck; reconciler being down too     -->
    <!-- makes the stuck-state permanent). Direct Python eliminates the   -->
    <!-- server-up dependency. No PIN auth needed for an in-process call. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/rohit/ytFactory &amp;&amp; PYTHONPATH=/Users/rohit/ytFactory /Users/rohit/ytFactory/.venv/bin/python -c 'import json; from control.core.reconciler import reconcile_stuck_jobs; r = reconcile_stuck_jobs(max_age_minutes=120, batch_size=50, dry_run=False); print(json.dumps({k:v for k,v in r.items() if k != "actions"}, default=str)); [print("ACTION:", a.get("action"), a.get("job_id","")[:8], (a.get("reason","")[:120])) for a in r.get("actions",[])]' &gt;&gt; /tmp/ytfactory-job-reconciler.log 2&gt;&amp;1; echo "---tick $(date -u +%FT%TZ)---" &gt;&gt; /tmp/ytfactory-job-reconciler.log</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Every 5 minutes. The worker's task-timeout is 60m, so any stuck -->
    <!-- job will be found within at most 125m (60m timeout + 60m         -->
    <!-- candidacy floor + 5m tick). That's fine — the dashboard already  -->
    <!-- shows the timeline pill so the user knows what stage it died    -->
    <!-- at; the reconciler just guarantees the spinner eventually       -->
    <!-- stops, not that it stops within seconds.                         -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>WorkingDirectory</key>
    <string>/Users/rohit/ytFactory</string>
    <key>StandardOutPath</key>
    <string>/tmp/ytfactory-job-reconciler.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ytfactory-job-reconciler.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/rohit</string>
        <key>PATH</key>
        <string>/Users/rohit/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- ADC lookup path; without GOOGLE_CLOUD_PROJECT the Firestore -->
        <!-- client falls back to ADC project metadata which works on    -->
        <!-- gcloud-authed laptops. Hardcoding it removes the fallback   -->
        <!-- path and any ambiguity in CI / new machines.                 -->
        <key>GOOGLE_CLOUD_PROJECT</key>
        <string>ytfactory-prod-v3</string>
    </dict>
</dict>
</plist>
