<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ytfactory.state-sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd /Users/rohit/ytFactory &amp;&amp; /Users/rohit/ytFactory/scripts/sync_state_to_gcs.sh &gt;&gt; /tmp/ytfactory-state-sync.log 2&gt;&amp;1</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Throttle: don't fire more often than every 60 seconds even if -->
    <!-- the user is rapidly editing files. -->
    <key>ThrottleInterval</key>
    <integer>60</integer>
    <!-- Trigger when any of these top-level dirs change. macOS launchd -->
    <!-- watches recursively. Sync runs the full per-channel sweep, so -->
    <!-- watching the channel roots is enough. -->
    <!-- Post-2026-05-23 (task #46): channel artifact roots live under  -->
    <!-- data/<channel>/ per pipeline/paths.py::RenderPaths.            -->
    <key>WatchPaths</key>
    <array>
        <string>/Users/rohit/ytFactory/data/mystoriesanimated/narrations</string>
        <string>/Users/rohit/ytFactory/data/mystoriesanimated/cast</string>
        <string>/Users/rohit/ytFactory/data/mystoriesanimated/uploads</string>
        <string>/Users/rohit/ytFactory/data/cosmosdecoded/narrations</string>
        <string>/Users/rohit/ytFactory/data/cosmosdecoded/cast</string>
        <string>/Users/rohit/ytFactory/data/cosmosdecoded/shotlist</string>
        <string>/Users/rohit/ytFactory/data/cosmosdecoded/uploads</string>
        <string>/Users/rohit/ytFactory/data/historyrecapped/narrations</string>
        <string>/Users/rohit/ytFactory/data/historyrecapped/cast</string>
        <string>/Users/rohit/ytFactory/data/historyrecapped/shotlist</string>
        <string>/Users/rohit/ytFactory/data/historyrecapped/uploads</string>
        <string>/Users/rohit/ytFactory/data/hindutavaanimated/narrations</string>
        <string>/Users/rohit/ytFactory/data/hindutavaanimated/cast</string>
        <string>/Users/rohit/ytFactory/data/hindutavaanimated/uploads</string>
        <string>/Users/rohit/ytFactory/data/sportsrecapped/narrations</string>
        <string>/Users/rohit/ytFactory/data/sportsrecapped/cast</string>
        <string>/Users/rohit/ytFactory/data/sportsrecapped/uploads</string>
        <string>/Users/rohit/ytFactory/data/scrollpulse/narrations</string>
        <string>/Users/rohit/ytFactory/data/scrollpulse/cast</string>
        <string>/Users/rohit/ytFactory/data/scrollpulse/uploads</string>
        <string>/Users/rohit/ytFactory/data/rhymetimejunction/narrations</string>
        <string>/Users/rohit/ytFactory/data/rhymetimejunction/uploads</string>
    </array>
    <key>StandardOutPath</key>
    <string>/tmp/ytfactory-state-sync.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ytfactory-state-sync.err</string>

    <!-- Audit D3.18 — pre-fix this plist had no EnvironmentVariables -->
    <!-- so launchd inherited only its minimal PATH. gsutil failed -->
    <!-- silently with "command not found"; state-sync appeared to -->
    <!-- "run" but actually never uploaded anything. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/rohit</string>
        <key>PATH</key>
        <string>/Users/rohit/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/rohit/google-cloud-sdk/bin</string>
        <key>CLOUDSDK_CONFIG</key>
        <string>/Users/rohit/.config/gcloud</string>
        <key>GOOGLE_CLOUD_PROJECT</key>
        <string>ytfactory-prod-v3</string>
    </dict>
</dict>
</plist>
