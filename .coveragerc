[run]
source = pipeline,web,control,scripts
branch = false
omit =
    */__pycache__/*
    */tests/*
    pipeline/text/test_hindi_normalize.py
parallel = false

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    if typing.TYPE_CHECKING:
    \.\.\.
    @abstractmethod
    @abc.abstractmethod
    def __repr__
    def __str__
show_missing = true
skip_covered = false
precision = 1
