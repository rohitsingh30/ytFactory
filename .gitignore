# Python
.venv/
**/__pycache__/
*.pyc

# Env / secrets
.env
.agent-token

# OS junk
.DS_Store

# IDE / agent local state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.playwright-mcp/
.vscode/

# Build artifacts
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/

# Model weights — never commit
*.onnx
*.bin
*.safetensors

# Cross-channel runtime data (kept under data/)
data/_jobs/
data/telemetry/
data/cache/
data/scratch/
data/intermediate/
data/_bench/

# YouTube stats cache — runtime-only, populated by
# pipeline.research.youtube.fetch_account on the laptop and by the
# cloud stats-refresh Job in prod (writes to gs://...-state). Was
# committed pre-2026-05-10 which let a test-fixture leak ("Biggie /
# UC_b / V_000") corrupt every prod deploy. Now ignored everywhere;
# laptop dev runs `python -m pipeline.research.youtube` to populate
# locally, prod reads from GCS (see docs/youtube_stats_refresh.md).
data/research/youtube/
data/research/analytics/

# Burner-channel cross-engage worker state — one JSON per burner slug
# (write via pipeline/cross_engage/burner_engage.py). Pure runtime
# state, mirrored to GCS in prod (see docs/cross_engage_cloud_v2.md).
# Pre-2026-05-11 these accumulated freely on disk; ignoring them keeps
# `git status` from drowning under ~100 transient files.
data/burner_engage/

# Cloud Build / Cloud Run deploy logs — captured by deploy.sh wrappers
# under cloud/<service>/deploy.sh. Already covered by the *.log rule
# below for the .log files but the .rc exit-code sidecars also leak;
# ignore the whole dir.
cloud/deploy_logs/

# Per-channel runtime artifacts (apply across every <channel>/ folder)
# Cache — per-slug intermediate render artifacts (regenerable via re-render)
**/cache/
# Scratch — ephemeral build directories
**/scratch/
# Footage source mp4s — large, downloaded from YouTube via yt-dlp
**/footage/sources/
# Long-form footage source mp4s — same idea, larger duration
**/footage/long_sources/
# Long-form final renders — mirror of `**/shorts/*.mp4`, regenerable
**/long_form/*.mp4
**/long_form/*.wav
# Emoji cache — twemoji PNGs (regenerable from CDN)
**/emoji/
# tts_tests — A/B test renders, not channel-canonical
**/tts_tests/
# Cooking loop sources — large mp4s pulled by scripts/pull_backgrounds.py
**/cooking_loops/
# Critique frame samples — regenerable by re-running /critique-video
**/critiques/*/frames/
# Final shorts MP4s — large, regenerable from narration + footage source.
# Upload records under <channel>/uploads/<slug>.json track which actually
# shipped to YouTube (with video IDs); that's the canonical record.
**/shorts/*.mp4

# Per-slug regenerable LLM-authored content — opt-out of tracking
# (cast/prompts/dossier/shotlist regen in seconds; transcripts in ~5min).
**/cast/**/*.json
**/prompts/**/*.json
**/dossier/**/*.json
**/shotlist/**/*.json
**/footage/transcripts/**/*.json
**/specs/**/*.yaml
**/cooking_bg_queue.yaml

# raw/, narrations/, uploads/ — tracked. They're small (avg ~1.5KB each),
# curated, and the cloud scheduler reads them to find unrendered work
# (raw + narrations) and which videos to display stats for (uploads).
# Without these the cloud control plane can't see the backlog.

# Screenshots / branding renders — both are artifacts, regenerable via
# their producer (UI tour for screenshots, branding.py for icons/banners).
docs/screenshots/
**/branding/*.png
**/branding/*.jpg

# Per-slug audio that ends up next to narrations
**/songs/*.wav
**/songs/*.mp3

# Logs / temp / backups
*.log
*.tmp
.tmp/
*.bak
*~
.env.azure
.env.*.local
.env.local

# Coverage runtime
.coverage
.coverage.*
.coverage_gate.*

# Agent / session ephemera (per-machine, not source)
.copilot/
.copilot-session/
.work/
