# Python
.venv/
**/__pycache__/
*.pyc

# Env / secrets
.env
.agent-token

# OS junk
.DS_Store

# IDE / agent local state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.playwright-mcp/
.vscode/

# Build artifacts
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/

# Model weights — never commit
*.onnx
*.bin
*.safetensors

# Cross-channel runtime data (kept under data/)
data/_jobs/
data/telemetry/
data/cache/
data/scratch/
data/intermediate/
data/_bench/

# Per-channel runtime artifacts (apply across every <channel>/ folder)
# Cache — per-slug intermediate render artifacts (regenerable via re-render)
**/cache/
# Scratch — ephemeral build directories
**/scratch/
# Footage source mp4s — large, downloaded from YouTube via yt-dlp
**/footage/sources/
# Long-form footage source mp4s — same idea, larger duration
**/footage/long_sources/
# Long-form final renders — mirror of `**/shorts/*.mp4`, regenerable
**/long_form/*.mp4
**/long_form/*.wav
# Emoji cache — twemoji PNGs (regenerable from CDN)
**/emoji/
# tts_tests — A/B test renders, not channel-canonical
**/tts_tests/
# Cooking loop sources — large mp4s pulled by scripts/pull_backgrounds.py
**/cooking_loops/
# Critique frame samples — regenerable by re-running /critique-video
**/critiques/*/frames/
# Final shorts MP4s — large, regenerable from narration + footage source.
# Upload records under <channel>/uploads/<slug>.json track which actually
# shipped to YouTube (with video IDs); that's the canonical record.
**/shorts/*.mp4

# Per-slug regenerable LLM-authored content — opt-out of tracking
# (cast/prompts/dossier/shotlist regen in seconds; transcripts in ~5min).
**/cast/**/*.json
**/prompts/**/*.json
**/dossier/**/*.json
**/shotlist/**/*.json
**/footage/transcripts/**/*.json
**/specs/**/*.yaml
**/cooking_bg_queue.yaml

# raw/, narrations/, uploads/ — tracked. They're small (avg ~1.5KB each),
# curated, and the cloud scheduler reads them to find unrendered work
# (raw + narrations) and which videos to display stats for (uploads).
# Without these the cloud control plane can't see the backlog.

# Screenshots / branding renders — both are artifacts, regenerable via
# their producer (UI tour for screenshots, branding.py for icons/banners).
docs/screenshots/
**/branding/*.png
**/branding/*.jpg

# Per-slug audio that ends up next to narrations
**/songs/*.wav
**/songs/*.mp3

# Logs / temp / backups
*.log
*.tmp
.tmp/
*.bak
*~
